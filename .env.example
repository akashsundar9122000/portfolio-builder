# ── Text AI (required for "Write it for me" and the assistant) ──────────
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,openai/gpt-oss-20b

# ── Invite codes and session signing (required) ─────────────────────────
CREATE_INVITE_CODES=CODE-ONE:6,CODE-TWO:6
CREATE_SESSION_SECRET=

# ── AI outfits: Cloudflare Workers AI (free daily allowance) ────────────
# Account ID: Cloudflare dashboard → Workers & Pages → right-hand sidebar.
# API token: My Profile → API Tokens → Create Token → "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────
# GEMINI_API_KEY=         # alternative outfit model (needs billing for images)
# UPSTASH_REDIS_REST_URL= # enforce per-code limits
# UPSTASH_REDIS_REST_TOKEN=
