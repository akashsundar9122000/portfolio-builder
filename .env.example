# ── Text AI (required for "Write it for me" and the assistant) ──────────
NVIDIA_API_KEY=
NVIDIA_MODEL=                           # optional override; default is a tested fallback list in lib/ai/nvidia.ts

AI_TEXT_FALLBACK=pollinations            # when NVIDIA is degraded, fall back to Pollinations text (≈0.0001 pollen/answer); "none" = NVIDIA only

# ── Invite codes and session signing (required) ─────────────────────────
# Permanent master codes (yours, for testing): CODE:portraitLimit. Visitors use emailed codes instead.
CREATE_INVITE_CODES=CODE-ONE:6,CODE-TWO:6
CREATE_SESSION_SECRET=                  # 32+ random chars; also signs admin cookies and email links

# ── Emailed access codes (landing page "Get a code") ────────────────────
# Needs Upstash Redis (below) to store requests and email→code mappings.
# Gmail: turn on 2-Step Verification for the account, then create an App Password
# at https://myaccount.google.com/apppasswords. Without these, emails are printed to the dev server log.
GMAIL_USER=                             # e.g. support.folioforge@gmail.com
GMAIL_APP_PASSWORD=                     # 16-character app password
# …or any SMTP provider instead of Gmail (takes priority when set). Brevo: Settings → SMTP & API.
SMTP_HOST=                              # e.g. smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=                              # Brevo "Login", e.g. 9xxxxx001@smtp-brevo.com
SMTP_PASS=                              # Brevo SMTP key
MAIL_FROM=                              # verified sender, e.g. support.folioforge@gmail.com
ADMIN_EMAIL=support.folioforge@gmail.com # where new requests are sent
ADMIN_PASSWORD=                         # signs you in to /admin (8+ chars)
APP_URL=                                # public site URL for email links, e.g. https://folioforge.vercel.app
ISSUED_PORTRAIT_LIMIT=6                 # AI portrait generations per emailed code

# ── Image generation gateway (lib/imagegen) ─────────────────────────────
# Pollinations: secret key (sk_…) from https://enter.pollinations.ai. Server-side only.
POLLINATIONS_API_KEY=
# Allow models Pollinations marks paid_only (spends pollen balance).
POLLINATIONS_ALLOW_PAID_MODELS=false
# AI Horde: key from https://aihorde.net/register. Empty = anonymous (lowest priority).
AI_HORDE_API_KEY=
IMAGE_PROVIDER_STRATEGY=AUTO            # AUTO | HEALTH_BASED | LEAST_LATENCY | ROUND_ROBIN | WEIGHTED
IMAGE_PROVIDER_WEIGHTS=                 # WEIGHTED only, e.g. pollinations:3,ai_horde:1
IMAGE_FORCE_PROVIDER=                   # dev/testing only: pollinations | ai_horde
IMAGE_MAX_PROVIDER_ATTEMPTS=2
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_MS=60000
PROVIDER_MAX_COOLDOWN_MS=900000
PROVIDER_HEALTH_WINDOW_SIZE=20
IMAGE_GENERATION_TIMEOUT_MS=120000      # synchronous provider deadline (routes allow 150 s)
AI_HORDE_MAX_WAIT_MS=600000             # AI Horde deletes requests after 10 minutes
IMAGE_REQUESTS_PER_MINUTE=5             # per user
IMAGE_GLOBAL_REQUESTS_PER_MINUTE=60
IMAGE_MODEL_MAP=                        # JSON override of lib/imagegen/models.ts
IMAGE_ADMIN_TOKEN=                      # enables GET /api/admin/image-providers (32+ random chars)

# ── Upstash Redis (required for emailed codes; also enforces per-code limits) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
